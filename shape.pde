void renderShape(int[][][] shapes,float x, float y,float scale, float angle){
    for (int v = 0; v<shapes.length; v++){
        int[][] shape = shapes[v];
        beginShape();
        for (int i = 0; i<shape.length; i++){
            int[] vs = shape[i];
            float[] angv = vector2angle((float)vs[0],(float)vs[1]);
            angv[0]+=angle;
            angv[1]*=scale;
            float[] updv = angle2vector(angv[0],angv[1]);
            vertex(x+updv[0],y+updv[1]);
        }
        endShape();
    }
}